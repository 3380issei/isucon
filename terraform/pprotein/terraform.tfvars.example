aws_region = "ap-northeast-1"
key_name   = "your-existing-ec2-key-pair"

# 各 PC の接続元グローバル IPv4 は、その PC で `curl -4 https://checkip.amazonaws.com` を実行して確認します。
# 以下は例示用アドレスです。確認した IP に /32 を付けて置き換えてください。
# 同じ回線を使う PC はグローバル IP が共通なので、1 件だけ指定すれば十分です。
ssh_ingress_cidrs = [
  "192.0.2.10/32",    # PC 1 の接続元
  "198.51.100.20/32", # PC 2 の接続元
]
